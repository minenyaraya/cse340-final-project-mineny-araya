<%- include('./partials/header') %>

<main>
    <section class="account-container">
        <h1>Welcome, <%= accountData.account_firstname %></h1>
        <p>You are logged in as a <strong><%= accountData.account_type %></strong>.</p>

        <% if (messages.notice) { %>
            <% messages.notice.forEach(message => { %>
                <p class="notice"><%= message %></p>
            <% }) %>
        <% } %>

        <div class="loan-info">
            <h2>Your Mortgage Application Status</h2>
            <p class="status-badge">Current Status: <strong><%= accountData.loan_status %></strong></p>
            
            <h3>Application Details</h3>
            <ul>
                <li><strong>Down Payment:</strong> $<%= accountData.initial_investment %></li>
                <li><strong>Credit Requested:</strong> $<%= accountData.loan_amount %></li>
                <li><strong>Property Category:</strong> <%= accountData.house_type.toUpperCase() %></li>
            </ul>
        </div>

        <p><a href="/logout" class="btn-logout">Logout</a></p>
    </section>
</main>

<%- include('./partials/footer') %>
