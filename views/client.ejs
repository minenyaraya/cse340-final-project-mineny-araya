<%- include('./partials/header') %>

<main>
    <section class="account-container">
        <h1>Welcome, <%= accountData.account_firstname %></h1>
        <p>You are logged in as a <strong><%= accountData.account_type %></strong>.</p>

        <% if (messages.notice) { %>
            <% messages.notice.forEach(message => { %>
                <p class="notice"><%= message %></p>
            <% }) %>
        <% } %>

        <% if (accountData.account_type === 'Client') { %>
            <div class="loan-info">
                <h2>Your Mortgage Application Status</h2>
                <p class="status-badge">Current Status: <strong><%= accountData.loan_status %></strong></p>
                
                <h3>Application Details</h3>
                <ul>
                    <li><strong>Down Payment:</strong> $<%= accountData.initial_investment %></li>
                    <li><strong>Credit Requested:</strong> $<%= accountData.loan_amount %></li>
                    <li><strong>Property Category:</strong> <%= accountData.house_type ? accountData.house_type.toUpperCase() : 'N/A' %></li>
                </ul>
            </div>
        <% } %>

        <% if (typeof allAccounts !== 'undefined' && allAccounts !== null) { %>
            <section class="admin-view">
                <h2>Manage All Loan Applications</h2>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Applicant Name</th>
                            <th>Email</th>
                            <th>Loan Amount</th>
                            <th>Current Status</th>
                            <th>Update Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% allAccounts.forEach(account => { %>
                            <% if (account.account_type === 'Client') { %>
                            <tr>
                                <td><%= account.account_firstname %> <%= account.account_lastname %></td>
                                <td><%= account.account_email %></td>
                                <td>$<%= account.loan_amount %></td>
                                <td><strong><%= account.loan_status %></strong></td>
                                <td>
                                    <form action="/account/update-status" method="POST" class="update-status-form">
                                        <input type="hidden" name="account_id" value="<%= account.account_id %>">
                                        <select name="loan_status">
                                            <option value="Pending" <%= account.loan_status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                            <option value="Under Review" <%= account.loan_status === 'Under Review' ? 'selected' : '' %>>Under Review</option>
                                            <option value="Approved" <%= account.loan_status === 'Approved' ? 'selected' : '' %>>Approved</option>
                                            <option value="Rejected" <%= account.loan_status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                                        </select>
                                        <button type="submit" class="btn-update">Save</button>
                                    </form>
                                </td>
                            </tr>
                            <% } %>
                        <% }) %>
                    </tbody>
                </table>
            </section>
        <% } %>

        <p><a href="/logout" class="btn-logout">Logout</a></p>
    </section>
</main>

<%- include('./partials/footer') %>
