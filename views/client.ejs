<%- include('./partials/header') %>

<main>
    <section class="account-container">
        <h1>Welcome, <%= accountData.account_firstname %></h1>
        <p>You are logged in as a <%= accountData.account_type %>.</p>

        <% if (messages.notice) { %>
            <% messages.notice.forEach(message => { %>
                <p class="notice"><%= message %></p>
            <% }) %>
        <% } %>

        <div class="loan-info">
            <h2>Your Loan Application Details</h2>
            <ul>
                <li><strong>Down Payment Provided:</strong> $<%= accountData.initial_investment %></li>
                <li><strong>Requested Credit Amount:</strong> $<%= accountData.loan_amount %></li>
                <li><strong>Selected Property Type:</strong> <%= accountData.house_type %></li>
            </ul>
        </div>

        <p><a href="/logout">Logout</a></p>
    </section>
</main>

<%- include('./partials/footer') %>
