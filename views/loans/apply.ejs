<% if (title) { %>
  <h1><%= title %></h1>
<% } %>

<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
  <% errors.array().forEach(error => { %>
    <li><%= error.msg %></li>
  <% }) %>
  </ul>
<% } %>

<div class="loan-form">
  <form action="/loans/apply" method="POST">
    <label for="initial_investment">Down Payment (USD):</label>
    <input type="number" name="initial_investment" id="initial_investment" required value="<%= locals.initial_investment %>">
    
    <label for="loan_amount">Loan Amount Requested (USD):</label>
    <input type="number" name="loan_amount" id="loan_amount" required value="<%= locals.loan_amount %>">
    
    <label for="house_type">Property Category:</label>
    <select name="house_type" id="house_type" required>
      <option value="">--Select--</option>
      <option value="new" <%= locals.house_type === 'new' ? 'selected' : '' %>>New House</option>
      <option value="used" <%= locals.house_type === 'used' ? 'selected' : '' %>>Used House</option>
      <option value="refinance" <%= locals.house_type === 'refinance' ? 'selected' : '' %>>Refinance</option>
    </select>
    
    <button type="submit">Submit Application</button>
  </form>
</div>
