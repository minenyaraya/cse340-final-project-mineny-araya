<%- include('./partials/header') %>

<main>
    <section class="hero">
        <h1>Neny Loans</h1>
        <p>Your path to home ownership starts here.</p>

        <% if (loggedin && accountData) { %>
            <div class="welcome-message">
                <h2>Hello, <%= accountData.account_firstname %>!</h2>
                <p>Welcome back. You currently have an active application for a <strong><%= accountData.house_type %></strong> home.</p>
                <a href="/client" class="btn">View My Dashboard</a>
            </div>
        <% } else { %>
            <div class="cta-buttons">
                <p>Ready to start? Join us today to apply for your home loan.</p>
                <a href="/register" class="btn">Start Application</a>
                <a href="/login" class="link">Already have an account? Login</a>
            </div>
        <% } %>
    </section>

    <% if (messages.notice) { %>
        <% messages.notice.forEach(message => { %>
            <p class="notice"><%= message %></p>
        <% }) %>
    <% } %>
</main>

<%- include('./partials/footer') %>
